<Window x:Class="NetAuth.UI.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetAuth · 계정 설정" Icon="/Assets/netauth.ico"
        Width="780" Height="500" MinWidth="660" MinHeight="400"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Malgun Gothic" FontSize="14"
        AutomationProperties.AutomationId="NetAuthAccountSettings">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="10"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary Source="AccountTheme.xaml" />
    </Window.Resources>

    <DockPanel Background="{StaticResource Surface}" TextElement.Foreground="{StaticResource Text}">
        <Border DockPanel.Dock="Top" Height="44" Background="White"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Image Source="/Assets/netauth.png" Width="23" Height="23" />
                    <TextBlock Text="NetAuth" Margin="8,0,0,0" FontFamily="Segoe UI"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Width="1" Height="13" Background="{StaticResource Line}" Margin="12,0" />
                    <TextBlock Text="계정 설정" FontSize="12"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="&#xE921;" Style="{StaticResource CaptionAction}" ToolTip="최소화"
                            Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="최소화" AutomationProperties.AutomationId="MinimizeWindow" />
                    <Button Click="ToggleMaximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="MaximizeOrRestoreWindow">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionAction}">
                                <Setter Property="Content" Value="&#xE922;" />
                                <Setter Property="ToolTip" Value="최대화" />
                                <Setter Property="AutomationProperties.Name" Value="최대화" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;" />
                                        <Setter Property="ToolTip" Value="이전 크기로 복원" />
                                        <Setter Property="AutomationProperties.Name" Value="이전 크기로 복원" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#xE8BB;" ToolTip="닫기" Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="닫기" AutomationProperties.AutomationId="CloseWindow">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionAction}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,1,0" Padding="25,31,24,20">
                <StackPanel>
                    <Image Source="/Assets/netauth.png" Width="55" Height="55" HorizontalAlignment="Left" />
                    <TextBlock Text="PClient 계정" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Brand}" Margin="0,15,0,0" />
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="13" LineHeight="21"
                               TextWrapping="Wrap" Margin="0,8,0,0">
                        <Run Text="현재 Windows 사용자 전용" /><LineBreak />
                        <Run Text="암호화 저장소를 사용합니다." />
                    </TextBlock>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="600" Margin="32,29,32,25">
                    <TextBlock x:Name="Heading" FontSize="27" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="Description" Foreground="{StaticResource Muted}"
                               Margin="0,7,0,22" LineHeight="22" TextWrapping="Wrap" />

                    <StackPanel x:Name="Editor">
                        <Label Content="PClient _ID" Target="{Binding ElementName=AccountId}" Padding="0,0,0,6"
                               FontWeight="SemiBold" />
                        <TextBox x:Name="AccountId" Style="{StaticResource Field}" MaxLength="256"
                                 AutomationProperties.AutomationId="PClientAccountId"
                                 AutomationProperties.Name="PClient ID" />
                        <Label Content="비밀번호" Target="{Binding ElementName=AccountPassword}"
                               Margin="0,13,0,0" Padding="0,0,0,6" FontWeight="SemiBold" />
                        <PasswordBox x:Name="AccountPassword" Style="{StaticResource Field}" MaxLength="1024"
                                     AutomationProperties.AutomationId="PClientAccountPassword"
                                     AutomationProperties.Name="PClient 비밀번호" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="계정 저장" Style="{StaticResource PrimaryAction}"
                                    IsDefault="True" Click="Save_Click" AutomationProperties.AutomationId="SaveAccount" />
                            <Button x:Name="CancelEditor" Content="나중에" Style="{StaticResource Action}"
                                    Margin="6,0,0,0" Click="CancelEdit_Click" AutomationProperties.AutomationId="CancelEdit" />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="RegisterButton" Content="계정 등록" Style="{StaticResource PrimaryAction}"
                            HorizontalAlignment="Left" Click="Edit_Click"
                            AutomationProperties.AutomationId="RegisterAccount" />

                    <StackPanel x:Name="SavedActions">
                        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="11" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Tint}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource Brand}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="PClient ID" Foreground="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock x:Name="SavedAccountId" Margin="0,3,0,0" FontSize="16"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="SavedAccountId" />
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="10" Padding="8,4"
                                        Background="{StaticResource SavedSurface}">
                                    <TextBlock Text="이 PC에 저장됨" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource SavedText}"
                                               AutomationProperties.AutomationId="AccountStatus" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="1,14,1,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="인증 상태" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="VerificationState" Grid.Column="1" Text="확인 전" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="VerificationState" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,13,0,10" />
                        <WrapPanel>
                            <Button x:Name="FillPClientIdButton" Content="PClient ID 채우기" Style="{StaticResource PrimaryAction}"
                                    Click="FillPClientId_Click" Margin="0,0,8,4"
                                    AutomationProperties.AutomationId="FillPClientId" />
                            <Button Content="계정 변경" Style="{StaticResource SecondaryAction}" Click="Edit_Click"
                                    Margin="0,0,8,4" AutomationProperties.AutomationId="EditAccount" />
                            <Button x:Name="DummyLogin" Content="인증 확인" Style="{StaticResource Action}"
                                    Click="DummyLogin_Click" Margin="0,0,8,4"
                                    AutomationProperties.AutomationId="TestDummyLogin" />
                            <Button x:Name="DeleteAccount" Content="저장 계정 삭제" Style="{StaticResource Action}"
                                    Foreground="{StaticResource Danger}" Click="ShowDelete_Click" Margin="0,0,0,4"
                                    AutomationProperties.AutomationId="DeleteAccount" />
                        </WrapPanel>
                    </StackPanel>

                    <Border x:Name="DeleteConfirmation" Margin="0,8,0,0" Padding="12"
                            Background="{StaticResource DangerSurface}" CornerRadius="8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="이 PC에 저장한 계정을 삭제할까요?" TextWrapping="Wrap"
                                       Foreground="{StaticResource Danger}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="ConfirmDelete" Content="삭제 확인" Style="{StaticResource SecondaryAction}"
                                        Foreground="{StaticResource Danger}" Click="ConfirmDelete_Click"
                                        AutomationProperties.AutomationId="ConfirmDelete" />
                                <Button Content="취소" Style="{StaticResource Action}" Margin="6,0,0,0"
                                        Click="CancelDelete_Click" AutomationProperties.AutomationId="CancelDelete" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FeedbackPanel" Margin="0,12,0,0" Padding="11,8" CornerRadius="7"
                            Visibility="Collapsed">
                        <TextBlock x:Name="Feedback" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AccountFeedback"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
