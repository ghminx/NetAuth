<Window x:Class="NetAuth.UI.AuthenticationNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="NetAuth · 네트워크 인증 알림"
        Width="400" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" UseLayoutRounding="True" FontFamily="Malgun Gothic"
        AutomationProperties.AutomationId="NetAuthAuthenticationNotification">
    <Window.Resources>
        <Style x:Key="NotificationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outline" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" CornerRadius="18" BorderThickness="1" Padding="16,14,16,16" BorderBrush="#2D5962">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0.65" EndPoint="1,0">
                <GradientStop Color="#121E30" Offset="0" />
                <GradientStop x:Name="CardTint" Color="#163640" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="24" Height="24" Source="/Assets/netauth.png" />
                    <TextBlock Text="NetAuth" Foreground="#E1EAF8" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <Button x:Name="DismissButton" Width="28" Height="28" HorizontalAlignment="Right"
                        BorderBrush="{Binding BorderBrush, ElementName=Card}"
                        Style="{StaticResource NotificationButton}" Click="Dismiss_Click"
                        AutomationProperties.Name="알림 닫기" AutomationProperties.AutomationId="DismissNotification">
                    <Path Data="M 0,0 L 7,7 M 7,0 L 0,7" Stroke="#B7C6D9" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>
            <Border Background="{Binding BorderBrush, ElementName=Card}" Height="1" Margin="0,10,0,12" />
            <Button Style="{StaticResource NotificationButton}" HorizontalContentAlignment="Stretch"
                    Click="OpenSettings_Click" AutomationProperties.Name="NetAuth 계정 설정 열기"
                    AutomationProperties.AutomationId="OpenNotificationSettings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusTile" Width="50" Height="50" CornerRadius="13" BorderThickness="1"
                            BorderBrush="{Binding BorderBrush, ElementName=Card}" Background="#19363F">
                        <Path x:Name="StatusGlyph" Data="M 15,2 C 19,4 22,6 28,7 L 28,15 C 28,23 23,28 15,32 C 7,28 2,23 2,15 L 2,7 C 8,6 11,4 15,2 M 9,17 L 13,21 L 21,12"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="27" Height="27"
                              Stretch="Uniform" Stroke="#70E0CF" StrokeThickness="1.8" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="PClient 로그인됨" Foreground="#F1F5FF"
                                   FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusDescription" Text="창원대 네트워크 인증을 확인했습니다." Foreground="#C5D2E4"
                                   FontSize="13" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
