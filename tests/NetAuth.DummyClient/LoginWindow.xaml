<Window x:Class="NetAuth.DummyClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetAuth 테스트용" AutomationProperties.AutomationId="NetAuthDummyLogin"
        Width="412" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" ShowActivated="False" Background="White"
        UseLayoutRounding="True" FontFamily="Malgun Gothic" FontSize="14" Foreground="#293B4E">
    <Window.Resources>
        <SolidColorBrush x:Key="Heading" Color="#18477B" />
        <SolidColorBrush x:Key="Muted" Color="#585F69" />
        <SolidColorBrush x:Key="FieldLine" Color="#687B92" />
        <Style x:Key="FieldIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="7,0,9,0" />
        </Style>
        <Style x:Key="FieldRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource FieldLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Heading}" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel Margin="42,28,42,21">
        <TextBlock Text="네트워크 접근제어 테스트" FontSize="22" FontWeight="Bold"
                   TextAlignment="Center" Foreground="{StaticResource Heading}" />
        <Border Width="82" Height="82" Margin="0,22,0,12" CornerRadius="19"
                Background="#E9F0F8" BorderBrush="#C4D6EB" BorderThickness="1">
            <TextBlock Text="NA" VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="29"
                       Foreground="{StaticResource Heading}" />
        </Border>
        <TextBlock x:Name="StatusText" Text="로그아웃 상태입니다."
                   AutomationProperties.AutomationId="AuthenticationStatus"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource Muted}" FontSize="15" />

        <StackPanel x:Name="Credentials" Margin="0,55,0,0">
            <Border Style="{StaticResource FieldRow}">
                <DockPanel>
                    <TextBlock Text="&#xE77B;" Style="{StaticResource FieldIcon}" />
                    <TextBox x:Name="UserId" AutomationProperties.AutomationId="UserId"
                             AutomationProperties.Name="테스트 ID" Text="demo-user" MaxLength="64"
                             BorderThickness="0" Background="Transparent"
                             MinHeight="43" VerticalContentAlignment="Center" />
                </DockPanel>
            </Border>
            <Border x:Name="PasswordRow" Style="{StaticResource FieldRow}" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource FieldIcon}" />
                    <PasswordBox x:Name="Password" AutomationProperties.AutomationId="Password"
                                 AutomationProperties.Name="테스트 비밀번호" MaxLength="64"
                                 BorderThickness="0" Background="Transparent"
                                 MinHeight="43" VerticalContentAlignment="Center" />
                </DockPanel>
            </Border>
            <Button x:Name="SubmitButton" AutomationProperties.AutomationId="SignIn"
                    Content="로그인" IsDefault="True" Click="SignIn_Click"
                    Margin="0,20,0,0" MinHeight="46" FontSize="16" FontWeight="Bold" Foreground="White">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#1C6F94" Offset="0" />
                        <GradientStop Color="#375CB3" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.87" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#667487" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <CheckBox Content="ID 저장" AutomationProperties.AutomationId="RememberId"
                          IsChecked="True" Margin="0,0,42,0" />
                <CheckBox Content="자동 로그인" AutomationProperties.AutomationId="AutoLogin" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
            <TextBlock x:Name="ScenarioText" Foreground="{StaticResource Muted}" FontSize="12" />
            <TextBlock Text=" · " Foreground="{StaticResource Muted}" FontSize="12" />
            <TextBlock x:Name="SubmissionCount" Text="제출 횟수 0회"
                       AutomationProperties.AutomationId="SubmissionCount"
                       Foreground="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
    </StackPanel>
</Window>
